# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
#
#   cp .env.example .env
#
# หมายเหตุ: ตั้งแต่ 2 ก.ย. 69 ทีมตกลงให้ `.env` ขึ้น repo ได้ (ทุกคนต้องใช้ค่าชุดเดียวกัน)
# **repo ต้องเป็น private เท่านั้น** — ถ้าจะเปิดสาธารณะ ต้องเปลี่ยนรหัสผ่าน DB กับ JWT_SECRET ก่อน
#
# ไฟล์นี้ถูกอ่านสองทาง: `cmd/api` อ่านค่าของแอป ส่วน `docker compose` อ่านค่าที่ขึ้นต้นด้วย
# POSTGRES_ / PGADMIN_ ไปใส่ให้คอนเทนเนอร์

# PostgreSQL — ชี้ไปที่ localhost:5433 (รัน `docker compose up -d db` บนเครื่องตัวเองก่อน)
# เปิดฐานข้อมูลด้วย: docker compose up -d (พอร์ต 5433 ดู docker-compose.yml)
# เครื่องที่ไม่มี Docker หรือจะต่อฐานข้อมูลกลางบน Pi แทน ให้ override ตัวแปรแวดล้อมนี้
# ชั่วคราวตอนรัน (`DATABASE_URL=postgres://...@192.168.8.190:5433/...`) ไม่ต้องแก้ไฟล์นี้
DATABASE_URL=postgres://bookstore:bookstore@localhost:5433/bookstore_t03?sslmode=disable

# พอร์ตของ API
PORT=8080

# กุญแจเซ็น JWT — สุ่มใหม่ด้วย: openssl rand -hex 32
# ถ้าไม่ตั้ง ระบบจะสุ่มให้ตอนบูต ผลคือ token เดิมใช้ไม่ได้หลังรีสตาร์ต
JWT_SECRET=058ed17e793a997b043557f435bfcf8cd7d85166430b438e51388b291c810d43

# อายุ token (ชั่วโมง) ไม่ตั้ง = 12
TOKEN_TTL_HOURS=12

# โดเมนของ frontend ที่เรียก API นี้ได้ คั่นด้วยจุลภาค
CORS_ORIGINS=http://localhost:5173,http://10.147.19.202:5173,http://192.168.8.190:5173

# ── ค่าที่ docker compose ใช้ (ไม่ได้ใช้โดย cmd/api) ─────────────────────
# รหัสผ่านของ role `bookstore` ในคอนเทนเนอร์ db · ต้องตรงกับที่อยู่ใน DATABASE_URL ข้างบน
# มีผลตอน initdb เท่านั้น เปลี่ยนทีหลังต้อง docker compose down -v
POSTGRES_PASSWORD=bookstore

# บัญชีเข้าหน้าเว็บ pgAdmin ที่ http://localhost:5050
# **เปลี่ยนรหัสผ่านถ้ารันบน Pi** เพราะพอร์ต 5050 เปิดให้ทั้งวง LAN
PGADMIN_EMAIL=admin@bookhaven.co.th
PGADMIN_PASSWORD=bookstore
