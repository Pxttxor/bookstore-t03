# คัดลอกไฟล์นี้เป็น .env ถ้าต้องชี้ไป API คนละที่ — .env ถูก .gitignore กันไว้ ห้าม commit
#
#   cp .env.example .env
#
# ปลายทางของ REST API (backend/) · ไม่ตั้งค่า = http://localhost:8080
# ต้องตรงกับ CORS_ORIGINS ฝั่ง backend ด้วย ไม่งั้นเบราว์เซอร์จะบล็อกทุกคำขอ
VITE_API_URL=http://localhost:8080
